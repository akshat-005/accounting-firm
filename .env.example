# ---------------------------------------------------------------------------
# Ledger & Legacy — Environment Variables
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit real secrets. `.env*` is gitignored.
#
# For Cloudflare preview/deploy, set the same values as Worker secrets/vars:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# and public (NEXT_PUBLIC_*) values in the Cloudflare Pages/Workers dashboard.
# ---------------------------------------------------------------------------

# --- Site ---
# Canonical production URL (no trailing slash). Used for SEO/canonical/sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (Phase 3+) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# Public anon key (RLS-protected; safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key — SERVER ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Firm contact channels (public, overrides site-config defaults) ---
NEXT_PUBLIC_FIRM_PHONE="+91 00000 00000"
NEXT_PUBLIC_FIRM_EMAIL="hello@ledgerandlegacy.com"
# WhatsApp number: digits only, country code first, no "+".
NEXT_PUBLIC_FIRM_WHATSAPP="910000000000"
# Google Maps place/embed URL (once the Business Profile is live).
NEXT_PUBLIC_MAPS_URL=""

# --- Social (public) ---
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""

# --- Analytics (Phase 4) ---
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Notifications / integrations (Phase 3+) ---
# Email + WhatsApp API credentials for lead notifications (server only).
# e.g. RESEND_API_KEY, WHATSAPP_API_TOKEN — add as needed.
RESEND_API_KEY=""

# --- Spam protection (Phase 3) ---
# Cloudflare Turnstile keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
